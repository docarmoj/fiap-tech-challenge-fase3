    {
      "name": "Historico GraphQL (8082)",
      "description": "DEV TASK 07. Roda inteira no Collection Runner.\n\nSuba o carehub-historico antes: cd carehub-historico && ./mvnw spring-boot:run\n\nEm GraphQL o status HTTP e sempre 200 mesmo quando o acesso e negado, entao os asserts olham o corpo: 'data' nulo e 'errors[0].extensions.classification'.\n\nA interface interativa fica em http://localhost:8082/graphiql (pede as mesmas credenciais).",
      "item": [
        {
          "name": "MEDICO consulta o historico de qualquer paciente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"query\": \"query { historicoPorPaciente(pacienteId: \\\"2\\\") { id dataHora status paciente { id nome } profissional { id nome } } }\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrlHistorico}}/graphql",
              "host": [
                "{{baseUrlHistorico}}"
              ],
              "path": [
                "graphql"
              ]
            },
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "medico1"
                },
                {
                  "key": "password",
                  "value": "{{senha}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 - em GraphQL o status e sempre 200', () => pm.response.to.have.status(200));",
                  "pm.test('sem erros no corpo', () => pm.expect(pm.response.json().errors, JSON.stringify(pm.response.json().errors)).to.be.undefined);",
                  "const consultas = pm.response.json().data.historicoPorPaciente;",
                  "pm.test('traz os atendimentos da carga inicial', () => pm.expect(consultas.map(c => c.id)).to.include.members(['3', '4']));",
                  "pm.test('todos sao do paciente pedido', () => pm.expect(consultas.every(c => c.paciente.id === '2')).to.be.true);",
                  "const datas = consultas.map(c => new Date(c.dataHora).getTime());",
                  "pm.test('ordenado do mais recente para o mais antigo', () => pm.expect(datas).to.eql(datas.slice().sort((a, b) => b - a)));"
                ]
              }
            }
          ]
        },
        {
          "name": "ENFERMEIRO consulta o historico de qualquer paciente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
